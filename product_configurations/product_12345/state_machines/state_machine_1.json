{
    "name": "state_machine_1",
    "description": "主状态机文件",
    "version": "1.0.0",
    "states": [
        {
            "id": "initial",
            "name": "初始状态",
            "description": "应用程序启动时的初始状态"
        },
        {
            "id": "loading",
            "name": "加载状态",
            "description": "正在加载UI布局和资源文件"
        },
        {
            "id": "ready",
            "name": "就绪状态",
            "description": "所有文件验证通过，应用程序准备就绪"
        },
        {
            "id": "error",
            "name": "错误状态",
            "description": "文件验证失败，需要用户干预"
        }
    ],
    "transitions": [
        {
            "from": "initial",
            "to": "loading",
            "trigger": "start_validation",
            "description": "开始文件验证流程"
        },
        {
            "from": "loading",
            "to": "ready",
            "trigger": "validation_success",
            "description": "所有文件验证成功"
        },
        {
            "from": "loading",
            "to": "error",
            "trigger": "validation_failed",
            "description": "文件验证失败"
        },
        {
            "from": "error",
            "to": "loading",
            "trigger": "retry_validation",
            "description": "重新尝试文件验证"
        }
    ],
    "initialState": "initial"
}